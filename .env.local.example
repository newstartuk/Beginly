# Beginly — Environment Variables
# Copy this file to .env.local locally and configure the same keys in Vercel.

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://cpzxtpwajxqbgyqtbbmx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key

# Public app URL
NEXT_PUBLIC_SITE_URL=https://beginly.app

# Resend — for transactional emails (welcome, reminders)
# Get your key at https://resend.com → API Keys
# Add a domain (beginly.app) in Resend → DNS → verify to send from @beginly.app
RESEND_API_KEY=replace_with_your_resend_api_key

FROM_EMAIL=noreply@beginly.app

# Server-only — do NOT expose to the browser bundle
# Used for admin-only operations and Row Level Security bypass in server contexts.
SUPABASE_SERVICE_ROLE_KEY=replace_only_in_server_environment_if_needed
